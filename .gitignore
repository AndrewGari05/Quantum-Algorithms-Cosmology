__pycache__/
*.pyc
*:Zone.Identifier
*.lock
# Run outputs. Wildcard patterns rather than exact names: `resultados/` did
# not cover `resultados_quick/`, `resultados_ro_0.03/` or any folder with its
# own --outdir, so a `git add -A` after a run pulled the whole run
# —figures, GIF, CSV— into the repo without anyone noticing until the commit.
# `results*/` covers the current English output names; `resultados*/` is kept
# for legacy campaigns written with the old Spanish names.
results*/
resultados*/
bridge.aux
bridge.log
bridge.out
bridge.toc
data_checksums.json
results_quick/
resultados_quick/
# Cumulative CSVs the runners append to in the working directory. A sample
# of the schema is kept in docs/examples/results_config_example.csv.
/results_config.csv
/resultados_config.csv
/results_all_models.csv
/resultados_TODOS_los_modelos.csv
